+        const shader_animation_interval_ns = 33 * std.time.ns_per_ms;
+
+        /// True when a custom shader animation frame is due: shaders are
+        /// loaded, `custom-shader-animation` allows animating in the current
+        /// focus state, and the last animation frame is at least
+        /// `shader_animation_interval_ns` old. Records the frame when due.
+        fn shaderAnimationFrameDue(self: *Self) bool {
+            if (!self.hasAnimations()) return false;
+            switch (self.config.custom_shader_animation) {
+                .false => return false,
+                .true => if (!self.focused) return false,
+                .always => {},
+            }
+
+            const now: std.Io.Timestamp = .now(global.io(), .awake);
+            if (self.last_shader_animation_frame) |last| {
+                if (last.durationTo(now).nanoseconds < shader_animation_interval_ns) return false;
+            }
+            self.last_shader_animation_frame = now;
+            return true;
+        }
